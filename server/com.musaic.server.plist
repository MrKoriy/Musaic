<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Musaic Server — launchd agent for macOS auto-start on login.

  Install (from the repository root; fills in the __PLACEHOLDERS__):
    mkdir -p ~/Library/Logs/Musaic
    sed -e "s|__BUN__|$(command -v bun)|" \
        -e "s|__SERVER_DIR__|$PWD/server|" \
        -e "s|__LOG_DIR__|$HOME/Library/Logs/Musaic|" \
        server/com.musaic.server.plist > ~/Library/LaunchAgents/com.musaic.server.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.musaic.server.plist

  Uninstall:
    launchctl bootout gui/$(id -u)/com.musaic.server
    rm ~/Library/LaunchAgents/com.musaic.server.plist

  Status / logs:
    launchctl print gui/$(id -u)/com.musaic.server | head
    tail -f ~/Library/Logs/Musaic/server.log ~/Library/Logs/Musaic/server-error.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.musaic.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>__BUN__</string>
    <string>src/index.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__SERVER_DIR__</string>

  <!-- Load environment from .env file handled by the process itself -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PORT</key>
    <string>3001</string>
  </dict>

  <!-- Start on user login -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Restart whenever the process exits (a crash may still exit 0) -->
  <key>KeepAlive</key>
  <true/>

  <!-- Throttle restart attempts (don't restart more than once per 10s) -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- Log output -->
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/server.log</string>

  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/server-error.log</string>
</dict>
</plist>
