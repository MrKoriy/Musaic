<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Musaic Server — launchd agent for macOS auto-start on login.

  Install:
    cp server/com.musaic.server.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.musaic.server.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.musaic.server.plist
    rm ~/Library/LaunchAgents/com.musaic.server.plist

  Check status:
    launchctl list | grep musaic

  View logs:
    tail -f /tmp/musaic-server.log
    tail -f /tmp/musaic-server-error.log

  NOTE: Update WorkingDirectory and ProgramArguments to match your installation path.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.musaic.server</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Path to bun binary — adjust if bun is installed elsewhere -->
    <string>/Users/leonid/.bun/bin/bun</string>
    <string>src/index.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <!-- Adjust to match your project path -->
  <string>/Users/leonid/Documents/coding/Vibecoded/Musaic/server</string>

  <!-- Load environment from .env file handled by the process itself -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PORT</key>
    <string>3001</string>
  </dict>

  <!-- Start on user login -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Restart automatically if the process exits unexpectedly -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- Throttle restart attempts (don't restart more than once per 10s) -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- Log output -->
  <key>StandardOutPath</key>
  <string>/tmp/musaic-server.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/musaic-server-error.log</string>
</dict>
</plist>
