# Network
HOST=0.0.0.0
PORT=3001
ALLOWED_ORIGINS=
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_PROVIDER_MAX=60
RATE_LIMIT_PROVIDER_WINDOW_MS=60000
RATE_LIMIT_VK_AUTH_MAX=5
RATE_LIMIT_CHAT_MAX=10
RATE_LIMIT_CHAT_WINDOW_MS=60000

# Database and local storage
DB_PATH=./musaic.db
MUSAIC_SECRET_PATH=./.musaic.secret
MUSAIC_SECRET_KEY=
MUSIC_DIR=
DOWNLOADS_DIR=./downloads
COVERS_DIR=./covers

# Authentication and session policy
REQUIRE_AUTH_READS=0
SESSION_TTL_DAYS=90

# VK
VK_OAUTH_CLIENT_ID=
ALLOW_VK_PASSWORD_AUTH=0
VK_APP_ID=
VK_APP_SECRET=
VK_OFFICIAL_APP_ID=
VK_OFFICIAL_APP_SECRET=

# Yandex
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# Optional providers
LASTFM_API_KEY=
GENIUS_ACCESS_TOKEN=
YTDLP_PATH=yt-dlp

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m2.5:free

# Media sidecar
MUSAIC_SIDECAR_PORT=8770
SIDECAR_DIR=
SIDECAR_URL=
SIDECAR_AUTOSTART=1

# Logging and background jobs
LOG_LEVEL=INFO
NODE_ENV=production
JOBS_ENABLED=1

# Local scan policy
ALLOW_SCAN_ANY_DIR=0

# Recommendation jobs and ranking
RECO_VARIANT=
RECO_REPEAT_COOLDOWN_HOURS=12
RECO_RANKER=shadow
RECO_DISCOVERY_RATIO=
RECO_DISCOVERY_RATIO_AUTO_MIX=
RECO_DISCOVERY_RATIO_FAVORITE=
RECO_DISCOVERY_RATIO_UNFAMILIAR=
RECO_DISCOVERY_RATIO_POPULAR=
RECO_ARTIST_GRAPH_LIMIT=300
RECO_TAG_BACKFILL_LIMIT=1800
RECO_AUDIO_EMBEDDING_LIMIT=50
AUDIO_EMBEDDINGS_ENABLED=0

# Lyrics pipeline
WHISPER_MODEL_PATH=
GGML_METAL_PATH_RESOURCES=

# Optional native Bun TLS
TLS_CERT=
TLS_KEY=

# Transcoding and cache limits
FFMPEG_MAX_CONCURRENT=2
FFMPEG_MAX_QUEUE=100
RECOMMENDATION_CACHE_MAX_ENTRIES=2000
